<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.gematik.liana</groupId>
    <artifactId>liana-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>liana-contract</artifactId>
  <name>LIANA Vertrag</name>
  <description>WSDL and XSD of the external interface of the Konnektor on the classpath</description>

  <!-- published under Apache 2.0 (LIANA-140) -->
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <!-- WSDL/XSD of the external interface of the Konnektor from support/schemas as resources, without moving them
       (LIANA-131). Java 17 for Primärsysteme (decision-016). -->
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- deployed without parent: dependencies with resolved versions, no Quarkus BOM for the user (LIANA-142) -->
    <flatten.mode>ossrh</flatten.mode>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/../support/schemas</directory>
        <targetPath>de/gematik/liana/contract/schemas</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- no JBoss LogManager: the client modules do not know Quarkus -->
          <systemPropertyVariables combine.self="override" />
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
      </plugin>
      <!-- LIANA-155.01: sources and javadoc for Maven Central -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
